---
// Menu / MenuSection / MenuItem JSON-LD, generated from the full menu data so
// search + AI engines can cite specific dishes and prices (AEO). Comprehensive
// on purpose — richer than the curated on-page panels.
import { menu } from '../data/menu.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'The Newport Cafe Menu',
  url: 'https://thenewportcafe.com/menu',
  inLanguage: 'en-US',
  hasMenuSection: menu.map((section) => ({
    '@type': 'MenuSection',
    name: section.title,
    hasMenuSection: section.groups.map((g) => ({
      '@type': 'MenuSection',
      name: g.title,
      ...(g.note ? { description: g.note } : {}),
      hasMenuItem: g.items.map((it) => {
        const price = it.price || g.priceAll;
        return {
          '@type': 'MenuItem',
          name: it.name,
          ...(it.desc ? { description: it.desc } : {}),
          ...(price ? { offers: { '@type': 'Offer', price, priceCurrency: 'USD' } } : {}),
        };
      }),
    })),
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
