---
// Meet the Crew — five comic hero cards with idle float + per-hero "power" FX
// on hover/focus. Art is the café's own (transparent PNGs in /img).
---
<section id="crew" class="halftone" style="position:relative;background:#FFCB05;padding:54px 20px 64px;border-top:5px solid #17140F;border-bottom:5px solid #17140F;">
  <div style="max-width:1220px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:10px;">
      <span style="display:inline-block;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1.5px;background:#2747A8;color:#fff;border:3px solid #17140F;padding:6px 14px;transform:rotate(-1.5deg);">Newport's own</span>
    </div>
    <h2 style="font-family:'Bangers',cursive;font-weight:400;text-align:center;font-size:72px;line-height:.9;margin:6px 0 4px;color:#fff;-webkit-text-stroke:3px #17140F;text-shadow:5px 5px 0 #E23A2E;">MEET THE CREW</h2>
    <p style="text-align:center;font-weight:700;font-size:18px;margin:0 auto 40px;max-width:600px;color:#3a3118;">Our hometown superheroes. Give one a tap (or a hover) and watch their powers go off.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(208px,1fr));gap:22px;align-items:end;">

      <div class="crew-card crew-card--bolt" tabindex="0" style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);outline:none;">
        <div style="position:relative;height:340px;overflow:hidden;background:linear-gradient(180deg,#fde9e8,#fff);">
          <div class="halftone-red" style="position:absolute;inset:0;opacity:.6;"></div>
          <div class="fx fx-speed" style="top:120px;right:18px;width:70px;height:6px;background:#E23A2E;border-radius:4px;box-shadow:0 14px 0 #FFCB05,0 -14px 0 #2747A8;"></div>
          <div class="fx fx-speed s2" style="top:150px;right:8px;width:54px;height:5px;background:#17140F;border-radius:4px;"></div>
          <div class="fx fx-speed s3" style="top:190px;right:22px;width:62px;height:5px;background:#E23A2E;border-radius:4px;"></div>
          <div class="fx fx-zap cp-bolt" style="top:24px;left:18px;width:44px;height:60px;background:#FFCB05;filter:drop-shadow(1px 1px 0 #17140F);"></div>
          <div class="fx fx-zap z2 cp-bolt" style="top:60px;right:18px;width:34px;height:48px;background:#FFCB05;filter:drop-shadow(1px 1px 0 #17140F);"></div>
          <div class="speech" style="position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:6;background:#fff;border:3px solid #17140F;border-radius:14px;padding:8px 12px;font-weight:700;font-size:12.5px;width:172px;text-align:center;box-shadow:3px 4px 0 rgba(23,20,15,.85);">Seated, poured &amp; fed before you finish the menu.</div>
          <img class="crew-img" src="/img/bolt.png" alt="Bolt, the lightning-fast Newport Cafe server" style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);height:292px;width:auto;z-index:4;" />
        </div>
        <div style="border-top:5px solid #17140F;background:#E23A2E;padding:10px 12px;text-align:center;">
          <div style="font-family:'Bangers',cursive;font-size:30px;line-height:1;color:#FFCB05;-webkit-text-stroke:1.5px #17140F;letter-spacing:1px;">BOLT</div>
          <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;font-size:11px;color:#fff;">Lightning service</div>
        </div>
      </div>

      <div class="crew-card crew-card--limelight" tabindex="0" style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);outline:none;">
        <div style="position:relative;height:340px;overflow:hidden;background:linear-gradient(180deg,#e7f5e4,#fff);">
          <div class="halftone" style="position:absolute;inset:0;opacity:.5;"></div>
          <div class="fx fx-slash" style="top:150px;left:30px;width:230px;height:7px;background:linear-gradient(90deg,rgba(255,255,255,0),#fff 40%,#bfe9ff);border-radius:6px;box-shadow:0 0 12px 3px rgba(191,233,255,.9);z-index:6;"></div>
          <div class="speech" style="position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:7;background:#fff;border:3px solid #17140F;border-radius:14px;padding:8px 12px;font-weight:700;font-size:12.5px;width:172px;text-align:center;box-shadow:3px 4px 0 rgba(23,20,15,.85);">I slice the 8-lb burger so you don't have to.</div>
          <img class="crew-img" src="/img/limelight.png" alt="Limelight, the Newport Cafe master burger slicer" style="position:absolute;bottom:18px;left:50%;transform:translateX(-50%);height:158px;width:auto;z-index:4;" />
        </div>
        <div style="border-top:5px solid #17140F;background:#3FA535;padding:10px 12px;text-align:center;">
          <div style="font-family:'Bangers',cursive;font-size:30px;line-height:1;color:#FFCB05;-webkit-text-stroke:1.5px #17140F;letter-spacing:1px;">LIMELIGHT</div>
          <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;font-size:11px;color:#fff;">Master burger slicer</div>
        </div>
      </div>

      <div class="crew-card crew-card--queen" tabindex="0" style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);outline:none;">
        <div style="position:relative;height:340px;overflow:hidden;background:linear-gradient(180deg,#efe9f7,#fff);">
          <div class="halftone" style="position:absolute;inset:0;opacity:.5;"></div>
          <div class="fx fx-spark" style="top:40px;left:40px;font-size:26px;color:#7A3FA5;z-index:6;">✦</div>
          <div class="fx fx-spark k2" style="top:80px;right:34px;font-size:20px;color:#FFCB05;z-index:6;">✦</div>
          <div class="fx fx-spark k3" style="top:150px;left:30px;font-size:22px;color:#7A3FA5;z-index:6;">✦</div>
          <div class="fx fx-spark k4" style="top:120px;right:46px;font-size:16px;color:#FFCB05;z-index:6;">✦</div>
          <div class="fx fx-boot" style="bottom:30px;left:50%;width:120px;height:60px;border-radius:50%;background:radial-gradient(circle,#bdfff0,rgba(120,230,255,0) 70%);z-index:3;"></div>
          <div class="speech" style="position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:7;background:#fff;border:3px solid #17140F;border-radius:14px;padding:8px 12px;font-weight:700;font-size:12.5px;width:174px;text-align:center;box-shadow:3px 4px 0 rgba(23,20,15,.85);">I remember your usual — and your usual's usual.</div>
          <img class="crew-img" src="/img/queen-m.png" alt="Queen M, who remembers every Newport Cafe order" style="position:absolute;bottom:4px;left:50%;transform:translateX(-50%);height:288px;width:auto;z-index:4;" />
        </div>
        <div style="border-top:5px solid #17140F;background:#7A3FA5;padding:10px 12px;text-align:center;">
          <div style="font-family:'Bangers',cursive;font-size:30px;line-height:1;color:#FFCB05;-webkit-text-stroke:1.5px #17140F;letter-spacing:1px;">QUEEN M</div>
          <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;font-size:11px;color:#fff;">Total recall</div>
        </div>
      </div>

      <div class="crew-card crew-card--baby" tabindex="0" style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);outline:none;">
        <div style="position:relative;height:340px;overflow:hidden;background:linear-gradient(180deg,#f3e6e6,#fff);">
          <div class="halftone" style="position:absolute;inset:0;opacity:.5;"></div>
          <div class="fx fx-nom ink-outline" style="top:30px;right:24px;z-index:6;"><div class="cp-boom" style="width:74px;height:74px;background:#E23A2E;display:grid;place-items:center;"><span style="font-family:'Bangers',cursive;color:#fff;font-size:20px;text-shadow:1px 1px 0 #17140F;">NOM!</span></div></div>
          <div class="fx fx-nom n2 ink-outline" style="bottom:90px;left:18px;z-index:6;"><div class="cp-boom" style="width:62px;height:62px;background:#FFCB05;display:grid;place-items:center;"><span style="font-family:'Bangers',cursive;color:#17140F;font-size:14px;">CHOMP</span></div></div>
          <div class="speech" style="position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:7;background:#fff;border:3px solid #17140F;border-radius:14px;padding:8px 12px;font-weight:700;font-size:12.5px;width:172px;text-align:center;box-shadow:3px 4px 0 rgba(23,20,15,.85);">Don't let the face fool you. I'll out-eat you.</div>
          <img class="crew-img" src="/img/babyface.png" alt="Babyface, the Newport Cafe challenge eater" style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);height:334px;width:auto;z-index:4;" />
        </div>
        <div style="border-top:5px solid #17140F;background:#8a1c1c;padding:10px 12px;text-align:center;">
          <div style="font-family:'Bangers',cursive;font-size:30px;line-height:1;color:#FFCB05;-webkit-text-stroke:1.5px #17140F;letter-spacing:1px;">BABYFACE</div>
          <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;font-size:11px;color:#fff;">Bottomless appetite</div>
        </div>
      </div>

      <div class="crew-card crew-card--founder" tabindex="0" style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);outline:none;">
        <div style="position:relative;height:340px;overflow:hidden;background:linear-gradient(180deg,#fdf0d8,#fff);">
          <div class="halftone" style="position:absolute;inset:0;opacity:.5;"></div>
          <div class="fx fx-ring" style="top:50%;left:50%;width:150px;height:150px;border-radius:50%;border:6px solid #FFCB05;z-index:3;"></div>
          <div class="fx fx-ring r2" style="top:50%;left:50%;width:200px;height:200px;border-radius:50%;border:5px solid #E23A2E;z-index:3;"></div>
          <div class="fx fx-laser" style="top:70px;left:30px;width:120px;height:4px;background:linear-gradient(90deg,#E23A2E,#FFF7C2);box-shadow:0 0 10px 2px rgba(226,58,46,.8);z-index:6;border-radius:3px;"></div>
          <div class="fx fx-laser" style="top:70px;right:30px;width:120px;height:4px;background:linear-gradient(270deg,#E23A2E,#FFF7C2);box-shadow:0 0 10px 2px rgba(226,58,46,.8);z-index:6;border-radius:3px;"></div>
          <div class="fx fx-big ink-outline" style="bottom:84px;right:12px;z-index:6;"><div class="cp-boom" style="width:80px;height:80px;background:#2747A8;display:grid;place-items:center;"><span style="font-family:'Bangers',cursive;color:#fff;font-size:22px;text-shadow:1px 1px 0 #17140F;">BIG!</span></div></div>
          <div class="speech" style="position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:7;background:#fff;border:3px solid #17140F;border-radius:14px;padding:8px 12px;font-weight:700;font-size:12.5px;width:174px;text-align:center;box-shadow:3px 4px 0 rgba(23,20,15,.85);">Est. 2008. Big portions are kind of my superpower.</div>
          <img class="crew-img" src="/img/founder.png" alt="The Founder of the Newport Cafe" style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);height:328px;width:auto;z-index:4;" />
        </div>
        <div style="border-top:5px solid #17140F;background:#2747A8;padding:10px 12px;text-align:center;">
          <div style="font-family:'Bangers',cursive;font-size:30px;line-height:1;color:#FFCB05;-webkit-text-stroke:1.5px #17140F;letter-spacing:1px;">THE FOUNDER</div>
          <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;font-size:11px;color:#fff;">Portion powerhouse</div>
        </div>
      </div>

    </div>
  </div>
</section>
