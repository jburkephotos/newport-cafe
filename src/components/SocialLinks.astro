---
{socials.length > 0 && (
  <div style="display:flex;gap:10px;align-items:center;margin-top:14px;">
    {socials.filter((s) => paths[s.platform]).map((s) => (
      <a href={s.url} target="_blank" rel="noopener" aria-label={`${site.name} on ${labels[s.platform] || s.platform}`} title={labels[s.platform]} class="btn-pop" style="display:grid;place-items:center;width:40px;height:40px;background:#FFCB05;border:3px solid #17140F;border-radius:6px;box-shadow:3px 4px 0 rgba(0,0,0,.5);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#17140F" aria-hidden="true"><path d={paths[s.platform]} /></svg>
      </a>
    ))}
  </div>
)}
