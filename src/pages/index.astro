---
import Base from '../layouts/Base.astro';
import CrewSection from '../components/CrewSection.astro';
import LaserDivider from '../components/LaserDivider.astro';
import VideoCard from '../components/VideoCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site.js';
import { videos } from '../data/videos.js';
---

<Base page="home">
  <!-- COVER -->
  <section class="halftone" style="position:relative;background:#FBF1DA;padding:30px 20px 54px;">
    <div style="max-width:1180px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:2px;font-size:13px;color:#17140F;border:3px solid #17140F;background:#FFCB05;padding:6px 14px;margin-bottom:14px;box-shadow:5px 6px 0 rgba(23,20,15,.85);">
        <span>Newport Cafe Comics</span>
        <span style="opacity:.8;">Issue #1 · Newport, Oregon</span>
        <span style="background:#E23A2E;color:#fff;padding:2px 8px;border:2px solid #17140F;">Est. 2008</span>
      </div>
      <div style="position:relative;border:6px solid #17140F;background:#fff;box-shadow:14px 16px 0 rgba(23,20,15,.85);overflow:hidden;">
        <div class="cover-grid" style="display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:8px;">
          <div style="padding:46px 20px 46px 46px;position:relative;z-index:3;">
            <div style="display:inline-block;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1.5px;font-size:14px;background:#2747A8;color:#fff;padding:5px 12px;border:2px solid #17140F;transform:rotate(-2deg);">Family diner · Oregon coast</div>
            <h1 class="h1-giant" style="font-family:'Bangers',cursive;font-weight:400;margin:16px 0 6px;font-size:92px;line-height:.86;letter-spacing:1.5px;color:#FFCB05;-webkit-text-stroke:3px #17140F;text-shadow:6px 6px 0 #E23A2E;">THE NEWPORT CAFE</h1>
            <p style="font-size:19px;line-height:1.45;max-width:440px;font-weight:600;color:#2a2620;margin:14px 0 24px;">One of the most diverse menus in Newport — homemade everything, fresh Yaquina Bay seafood, and famously <span style="background:#FFCB05;padding:0 5px;box-decoration-break:clone;">huge portions.</span></p>
            <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
              <a class="btn-pop" href={site.phoneHref} style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:18px;padding:14px 22px;background:#E23A2E;color:#fff;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">Call (541) 574-6847</a>
              <a class="btn-pop" href="/menu" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:18px;padding:14px 22px;background:#fff;color:#17140F;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">See the Menu →</a>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:26px;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:.6px;font-size:13px;">
              <span style="background:#17140F;color:#fff;padding:7px 12px;border-radius:3px;">7AM – 10PM · every day</span>
              <a href={site.mapsUrl} target="_blank" rel="noopener" style="background:#fff;color:#17140F;padding:7px 12px;border:2px solid #17140F;border-radius:3px;text-decoration:none;">534 N Coast Hwy, Newport</a>
            </div>
          </div>
          <div style="position:relative;display:grid;place-items:center;min-height:540px;padding:18px;">
            <div class="rays" style="position:absolute;width:430px;height:430px;border-radius:50%;border:6px solid #17140F;box-shadow:inset 0 0 0 10px rgba(255,255,255,.25);"></div>
            <div class="halftone-light" style="position:absolute;width:430px;height:430px;border-radius:50%;"></div>
            <img class="crew-img" src="/img/founder.png" alt="The Founder of the Newport Cafe, drawn as a caped superhero" style="position:relative;z-index:2;height:510px;width:auto;filter:drop-shadow(7px 9px 0 rgba(23,20,15,.28));" />
            <div style="position:absolute;top:0;left:-4px;transform:rotate(-13deg);z-index:4;" class="ink-outline-hard">
              <div class="cp-boom" style="width:186px;height:186px;background:#E23A2E;display:grid;place-items:center;text-align:center;padding:16px;">
                <div style="line-height:1;">
                  <div style="font-family:'Bangers',cursive;color:#fff;font-size:28px;text-shadow:1.5px 1.5px 0 #17140F;">VOTED #1</div>
                  <div style="font-family:'Bangers',cursive;color:#fff;font-size:11px;line-height:.95;margin-top:2px;text-shadow:1px 1px 0 #17140F;">BEST OF THE BEST<br>LINCOLN COUNTY</div>
                  <div style="font-family:'Anton',sans-serif;text-transform:uppercase;color:#fff;font-size:8px;letter-spacing:.3px;line-height:1.25;margin-top:5px;">Voted by readers of the<br>Newport News-Times<br>2014–2024</div>
                </div>
              </div>
            </div>
            <div style="position:absolute;top:-6px;right:6px;transform:rotate(10deg);z-index:4;" class="ink-outline-hard">
              <div class="cp-boom" style="width:120px;height:120px;background:#FFCB05;display:grid;place-items:center;text-align:center;">
                <span style="font-family:'Bangers',cursive;color:#17140F;font-size:18px;line-height:.84;">HUGE<br>PORTIONS!</span>
              </div>
            </div>
            <div style="position:absolute;bottom:34px;right:-6px;transform:rotate(-7deg);z-index:4;" class="ink-outline-hard">
              <div class="cp-boom" style="width:116px;height:116px;background:#2747A8;display:grid;place-items:center;text-align:center;">
                <span style="font-family:'Bangers',cursive;color:#fff;font-size:16px;line-height:.86;">EVERYTHING<br>HOMEMADE</span>
              </div>
            </div>
            <div style="position:absolute;bottom:18px;left:-4px;transform:rotate(8deg);z-index:4;" class="ink-outline-hard">
              <div class="cp-boom" style="width:106px;height:106px;background:#fff;display:grid;place-items:center;text-align:center;">
                <span style="font-family:'Bangers',cursive;color:#E23A2E;font-size:18px;line-height:.84;">OPEN<br>7 DAYS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <LaserDivider />
  <CrewSection />
  <LaserDivider />

  <!-- MONSTER BURGER -->
  <section id="monster" class="halftone-red" style="position:relative;background:#17140F;color:#fff;padding:60px 20px 66px;overflow:hidden;">
    <div style="max-width:1180px;margin:0 auto;position:relative;">
      <div class="monster-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center;">
        <div style="position:relative;">
          <div style="display:inline-block;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1.5px;font-size:14px;background:#FFCB05;color:#17140F;padding:5px 12px;border:2px solid #000;transform:rotate(-2deg);">The legend · the challenge</div>
          <h2 style="font-family:'Bangers',cursive;font-weight:400;font-size:62px;line-height:.86;margin:16px 0 6px;color:#FFCB05;-webkit-text-stroke:2.5px #000;text-shadow:5px 5px 0 #E23A2E;">HOME OF THE 8&nbsp;LB SUPER ULTIMATE MONSTER BURGER</h2>
          <p style="font-size:18px;line-height:1.5;font-weight:500;color:#f1e7d4;max-width:480px;margin:14px 0 22px;">Eight pounds of homemade burger, grilled onions, ham and <strong style="color:#FFCB05;">eight</strong> fried eggs on a 10-inch house-made bun. Think you can finish it?</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
            <div style="background:#fff;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">The Monster · 3 lb</div><div style="font-family:'Bangers',cursive;font-size:28px;color:#E23A2E;line-height:1;">$18</div></div>
            <div style="background:#fff;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">Ultimate · 4 lb</div><div style="font-family:'Bangers',cursive;font-size:28px;color:#E23A2E;line-height:1;">$25</div></div>
            <div style="background:#FFCB05;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);transform:rotate(-2deg);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">Super Ultimate · 8 lb</div><div style="font-family:'Bangers',cursive;font-size:30px;color:#E23A2E;line-height:1;">$60</div></div>
          </div>
          <a class="btn-pop" href="/monster-burger" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:17px;padding:13px 20px;background:#E23A2E;color:#fff;border:4px solid #000;box-shadow:5px 6px 0 rgba(0,0,0,.7);border-radius:3px;display:inline-block;">Take the challenge →</a>
        </div>
        <div style="position:relative;display:grid;place-items:center;min-height:520px;">
          <img src="/img/monster-burger.png" alt="The 8 lb Super Ultimate Monster Burger" style="position:relative;z-index:3;width:100%;max-width:576px;height:auto;object-fit:contain;" />
          <img class="crew-img" src="/img/babyface.png" alt="Babyface taking on the Monster Burger challenge" style="position:absolute;right:-6px;bottom:-10px;height:280px;width:auto;z-index:4;filter:drop-shadow(4px 5px 0 rgba(0,0,0,.5));" />
          <div class="ink-outline" style="position:absolute;top:0;left:-6px;transform:rotate(-8deg);z-index:5;"><div class="cp-boom" style="width:96px;height:96px;background:#FFCB05;display:grid;place-items:center;text-align:center;"><span style="font-family:'Bangers',cursive;color:#17140F;font-size:15px;line-height:.85;">CAN YOU<br>FINISH<br>IT?</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE'RE FAMOUS FOR -->
  <section class="halftone" style="background:#FBF1DA;padding:58px 20px;border-top:5px solid #17140F;">
    <div style="max-width:1120px;margin:0 auto;">
      <h2 style="font-family:'Bangers',cursive;font-weight:400;text-align:center;font-size:60px;line-height:.9;margin:0 0 6px;color:#E23A2E;-webkit-text-stroke:2.5px #17140F;text-shadow:4px 4px 0 #FFCB05;">WHAT WE'RE FAMOUS FOR</h2>
      <p style="text-align:center;font-weight:700;font-size:18px;margin:0 auto 36px;max-width:620px;color:#3a3118;">One of the most diverse menus in Newport — “looking for something specific? We probably have it.”</p>
      <div class="fam-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:26px;">
        <div style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);overflow:hidden;">
          <img src="/img/fam-burgers.png" alt="A stacked Newport Cafe Monster burger" style="display:block;width:100%;height:300px;object-fit:cover;background:#efe6cf;" />
          <div style="border-top:5px solid #17140F;padding:18px;">
            <div style="font-family:'Bangers',cursive;font-size:30px;color:#E23A2E;-webkit-text-stroke:1px #17140F;line-height:1;">THE BURGERS</div>
            <p style="font-weight:600;font-size:16px;margin:6px 0 0;color:#2a2620;">Hand-pressed 1 lb burgers &amp; the legendary Monster series.</p>
          </div>
        </div>
        <div style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:9px 10px 0 rgba(23,20,15,.85);overflow:hidden;">
          <img src="/img/fam-breakfast.png" alt="Homemade biscuits and country sausage gravy with eggs and bacon" style="display:block;width:100%;height:300px;object-fit:cover;background:#efe6cf;" />
          <div style="border-top:5px solid #17140F;padding:18px;">
            <div style="font-family:'Bangers',cursive;font-size:30px;color:#2747A8;-webkit-text-stroke:1px #17140F;line-height:1;">BREAKFAST &amp; SEAFOOD</div>
            <p style="font-weight:600;font-size:16px;margin:6px 0 0;color:#2a2620;">All-day breakfast, fresh Yaquina Bay oysters &amp; clam chowder in a bread bowl.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRADITION SINCE 2008 -->
  <section id="visit" class="rays" style="position:relative;padding:58px 20px;border-top:5px solid #17140F;">
    <div class="halftone-light" style="position:absolute;inset:0;"></div>
    <div style="position:relative;max-width:1120px;margin:0 auto;">
      <div class="trad-grid" style="display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center;">
        <div style="position:relative;background:#fff;border:5px solid #17140F;border-radius:5px;box-shadow:10px 11px 0 rgba(23,20,15,.85);overflow:hidden;">
          <img src="/img/burger-car.png" alt="The burger-wrapped Newport Cafe car parked on Highway 101" style="display:block;width:100%;height:360px;object-fit:cover;background:#efe6cf;" />
          <div class="ink-outline" style="position:absolute;top:12px;right:12px;transform:rotate(7deg);"><div class="cp-boom" style="width:92px;height:92px;background:#E23A2E;display:grid;place-items:center;text-align:center;"><span style="font-family:'Bangers',cursive;color:#fff;font-size:14px;line-height:.85;text-shadow:1px 1px 0 #17140F;">ON HWY<br>101!</span></div></div>
        </div>
        <div>
          <div style="display:inline-block;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1.5px;font-size:14px;background:#2747A8;color:#fff;padding:5px 12px;border:2px solid #17140F;transform:rotate(-1.5deg);">Since 2008</div>
          <h2 style="font-family:'Bangers',cursive;font-weight:400;font-size:54px;line-height:.9;margin:14px 0 8px;color:#17140F;text-shadow:3px 3px 0 #fff;">A NEWPORT TRADITION</h2>
          <p style="font-size:18px;line-height:1.55;font-weight:500;color:#2a2620;max-width:440px;">Family-style coastal diner since 2008. Comfort food, fresh seafood, and famously huge portions — open 365 days a year. You can't miss us on Highway 101 — just look for the burger on wheels.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:22px;">
            <a class="btn-pop" href={site.mapsUrl} target="_blank" rel="noopener" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:16px;padding:12px 18px;background:#E23A2E;color:#fff;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">Get directions</a>
            <a class="btn-pop" href={site.phoneHref} style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:16px;padding:12px 18px;background:#fff;color:#17140F;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">Call ahead</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEE IT IN ACTION -->
  <section class="halftone-red" style="background:#17140F;color:#fff;padding:54px 20px;border-top:5px solid #17140F;">
    <div style="max-width:1160px;margin:0 auto;">
      <h2 style="font-family:'Bangers',cursive;font-weight:400;text-align:center;font-size:54px;line-height:.9;margin:0 0 6px;color:#FFCB05;-webkit-text-stroke:2.5px #000;text-shadow:4px 4px 0 #E23A2E;">SEE IT IN ACTION</h2>
      <p style="text-align:center;font-weight:600;font-size:16px;margin:0 auto 34px;max-width:560px;color:#e9dcc6;">From the Monster Burger Challenge to the Fabulous Newports — tap a panel to play.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(252px,1fr));gap:20px;">
        {videos.map((v) => <VideoCard video={v} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="rays-red" style="position:relative;padding:56px 20px 26px;border-top:5px solid #17140F;">
    <div class="halftone-light" style="position:absolute;inset:0;"></div>
    <div style="position:relative;max-width:1080px;margin:0 auto;text-align:center;">
      <div style="display:inline-block;background:#17140F;color:#FFCB05;font-family:'Bangers',cursive;font-size:46px;line-height:1;padding:14px 26px;border:5px solid #17140F;transform:rotate(-1deg);box-shadow:8px 9px 0 rgba(23,20,15,.4);-webkit-text-stroke:1px #FFCB05;">OPEN EVERY DAY · 7AM – 10PM</div>
      <p style="font-weight:700;font-size:17px;margin:18px 0 22px;color:#fff;text-shadow:1px 1px 0 rgba(0,0,0,.4);">Open 365 days a year · 534 N Coast Hwy, Newport, OR 97365</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
        <a class="btn-pop" href={site.phoneHref} style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:18px;padding:14px 22px;background:#E23A2E;color:#fff;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">Call (541) 574-6847</a>
        <a class="btn-pop" href="/menu" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:18px;padding:14px 22px;background:#fff;color:#17140F;border:4px solid #17140F;box-shadow:5px 6px 0 rgba(23,20,15,.9);border-radius:3px;">View Menu</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="background:#17140F;color:#f1e7d4;padding:40px 20px 26px;border-top:5px solid #17140F;">
    <div style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:28px;" class="fam-grid">
      <div>
        <img src="/img/logo.png" alt="The Newport Cafe" style="height:74px;width:auto;background:#fff;border:3px solid #000;border-radius:6px;padding:6px;" />
        <p style="font-size:14.5px;line-height:1.55;margin:14px 0 0;max-width:320px;color:#d8cbb4;">Family-style coastal diner since 2008. Comfort food, fresh seafood, and famously huge portions — open 365 days a year.</p>
        <SocialLinks />
      </div>
      <div>
        <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;color:#FFCB05;font-size:16px;margin-bottom:10px;">Visit</div>
        <p style="font-size:14.5px;line-height:1.6;margin:0;color:#d8cbb4;">534 N Coast Hwy<br>Newport, OR 97365<br><a href={site.mapsUrl} target="_blank" rel="noopener" style="color:#FFCB05;text-decoration:none;font-weight:700;">Get directions →</a></p>
      </div>
      <div>
        <div style="font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1px;color:#FFCB05;font-size:16px;margin-bottom:10px;">Hours &amp; Phone</div>
        <p style="font-size:14.5px;line-height:1.6;margin:0;color:#d8cbb4;">7:00 AM – 10:00 PM, every day<br><em>Open 365 days a year</em><br><a href={site.phoneHref} style="color:#FFCB05;text-decoration:none;font-weight:700;">(541) 574-6847</a></p>
      </div>
    </div>
    <div style="max-width:1120px;margin:26px auto 0;border-top:1px solid #3a342a;padding-top:16px;font-size:13px;color:#988e78;">© {new Date().getFullYear()} The Newport Cafe. Established 2008 · Newport, Oregon.</div>
  </footer>
</Base>
