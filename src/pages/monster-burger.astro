---
import Base from '../layouts/Base.astro';
import FaqSection from '../components/FaqSection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site.js';
import { monsterFaqs } from '../data/faqs.js';

const title = 'The 8 lb Super Ultimate Monster Burger Challenge — Newport Cafe';
const description =
  'The Super Ultimate Monster Burger at the Newport Cafe in Newport, OR: 8 lb of homemade burger, grilled onions, ham and eight fried eggs on a 10-inch bun — $60. Plus the 3 lb Monster ($18) and 4 lb Ultimate ($25). Can you finish it?';

// Product/MenuItem schema for the burger itself (offers + price).
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'MenuItem',
  name: 'Super Ultimate Monster Burger',
  description:
    '8 lb of homemade burger, grilled onions, ham and eight fried eggs on a 10-inch house-made bun.',
  image: 'https://thenewportcafe.com/img/monster-burger.png',
  menuAddOn: undefined,
  offers: { '@type': 'Offer', price: '60', priceCurrency: 'USD' },
};
---
<Base title={title} description={description} page="home">
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline />
  <Breadcrumb items={[{ name: 'Home', url: '/' }, { name: 'Monster Burger', url: '/monster-burger' }]} />

  <!-- HERO / THE CHALLENGE -->
  <section class="halftone-red" style="position:relative;background:#17140F;color:#fff;padding:48px 20px 60px;overflow:hidden;">
    <div style="max-width:1180px;margin:0 auto;">
      <div class="monster-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center;">
        <div style="position:relative;">
          <div style="display:inline-block;font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:1.5px;font-size:14px;background:#FFCB05;color:#17140F;padding:5px 12px;border:2px solid #000;transform:rotate(-2deg);">Home of the legend</div>
          <h1 style="font-family:'Bangers',cursive;font-weight:400;font-size:66px;line-height:.84;margin:16px 0 6px;color:#FFCB05;-webkit-text-stroke:2.5px #000;text-shadow:5px 5px 0 #E23A2E;">THE 8&nbsp;LB SUPER ULTIMATE MONSTER BURGER</h1>
          <p style="font-size:18px;line-height:1.5;font-weight:500;color:#f1e7d4;max-width:480px;margin:14px 0 22px;">Eight pounds of homemade burger, grilled onions, ham and <strong style="color:#FFCB05;">eight</strong> fried eggs on a 10-inch house-made bun. It's $60, it's on the menu every day — and it is, technically, a personality test.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
            <div style="background:#fff;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">The Monster · 3 lb</div><div style="font-family:'Bangers',cursive;font-size:28px;color:#E23A2E;line-height:1;">$18</div></div>
            <div style="background:#fff;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">Ultimate · 4 lb</div><div style="font-family:'Bangers',cursive;font-size:28px;color:#E23A2E;line-height:1;">$25</div></div>
            <div style="background:#FFCB05;color:#17140F;border:3px solid #000;border-radius:4px;padding:8px 14px;box-shadow:4px 5px 0 rgba(0,0,0,.6);transform:rotate(-2deg);"><div style="font-family:'Anton',sans-serif;text-transform:uppercase;font-size:12px;letter-spacing:.5px;">Super Ultimate · 8 lb</div><div style="font-family:'Bangers',cursive;font-size:30px;color:#E23A2E;line-height:1;">$60</div></div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:12px;">
            <a class="btn-pop" href={site.phoneHref} style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:17px;padding:13px 20px;background:#E23A2E;color:#fff;border:4px solid #000;box-shadow:5px 6px 0 rgba(0,0,0,.7);border-radius:3px;">Call to order</a>
            <a class="btn-pop" href="/menu" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:17px;padding:13px 20px;background:#fff;color:#17140F;border:4px solid #000;box-shadow:5px 6px 0 rgba(0,0,0,.7);border-radius:3px;">Full menu →</a>
          </div>
        </div>
        <div style="position:relative;display:grid;place-items:center;min-height:460px;">
          <img src="/img/monster-burger.png" alt="The 8 lb Super Ultimate Monster Burger at the Newport Cafe" style="position:relative;z-index:2;width:100%;max-width:600px;height:auto;object-fit:contain;filter:drop-shadow(5px 7px 0 rgba(0,0,0,.45));" />
          <img class="bob" src="/img/babyface.png" alt="Babyface taking on the Monster Burger challenge" style="position:absolute;right:-4px;bottom:-18px;height:250px;width:auto;z-index:3;filter:drop-shadow(4px 5px 0 rgba(0,0,0,.5));" />
          <div class="ink-outline" style="position:absolute;top:-6px;left:-6px;transform:rotate(-9deg);z-index:4;"><div class="cp-boom" style="width:110px;height:110px;background:#E23A2E;display:grid;place-items:center;text-align:center;"><span style="font-family:'Bangers',cursive;color:#fff;font-size:17px;line-height:.82;text-shadow:1.5px 1.5px 0 #17140F;">CAN YOU<br>FINISH<br>IT?</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FaqSection faqs={monsterFaqs} heading="THE BIG QUESTIONS" kicker="Monster Burger FAQ" />

  <!-- CTA + FOOTER -->
  <section class="halftone-red" style="background:#17140F;color:#f1e7d4;padding:44px 20px 26px;border-top:5px solid #17140F;text-align:center;">
    <div style="max-width:900px;margin:0 auto;">
      <h2 style="font-family:'Bangers',cursive;font-weight:400;font-size:42px;margin:0 0 8px;color:#FFCB05;-webkit-text-stroke:1px #000;">READY TO MEET THE MONSTER?</h2>
      <p style="font-weight:600;margin:0 0 20px;color:#d8cbb4;">Open 7AM – 10PM, every day · 534 N Coast Hwy, Newport, OR · 365 days a year.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
        <a class="btn-pop" href={site.phoneHref} style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:17px;padding:13px 20px;background:#E23A2E;color:#fff;border:4px solid #000;box-shadow:5px 6px 0 rgba(0,0,0,.7);border-radius:3px;">Call (541) 574-6847</a>
        <a class="btn-pop" href="/" style="font-family:'Anton',sans-serif;text-decoration:none;text-transform:uppercase;letter-spacing:.5px;font-size:17px;padding:13px 20px;background:#fff;color:#17140F;border:4px solid #000;box-shadow:5px 6px 0 rgba(0,0,0,.7);border-radius:3px;">← Back home</a>
      </div>
      <div style="margin-top:24px;font-size:13px;color:#988e78;">© {new Date().getFullYear()} The Newport Cafe. Established 2008 · Newport, Oregon.</div>
    </div>
  </section>
</Base>
