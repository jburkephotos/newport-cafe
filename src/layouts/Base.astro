---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { site } from '../data/site.js';

const {
  title = `${site.legalName} — Family Diner in Newport, Oregon`,
  description = `${site.legalName}: family-style coastal diner in Newport, OR since ${site.established}. Breakfast, seafood, burgers and famously huge portions, open 7AM–10PM every day. ${site.phoneDisplay}.`,
  page = 'home',
  schema = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const noindex = import.meta.env.PUBLIC_NOINDEX === '1' || import.meta.env.PUBLIC_NOINDEX === 'true';

// Plausible analytics (only in builds; the script ignores localhost anyway).
const plausibleDomain = site.analytics?.plausibleDomain;
const enableAnalytics = import.meta.env.PROD && Boolean(plausibleDomain);
const analyticsJs =
  "window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};" +
  "document.addEventListener('click',function(e){var a=e.target.closest?e.target.closest('a'):null;if(!a)return;" +
  "var h=a.getAttribute('href')||'';if(h.indexOf('tel:')===0){window.plausible('Call')}" +
  "else if((a.protocol==='http:'||a.protocol==='https:')&&a.host&&a.host!==location.host){window.plausible('Outbound Link',{props:{url:a.href}})}});";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#E23A2E" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800;900&family=Bangers&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

    {schema && <SchemaOrg canonical={canonical} />}

    {enableAnalytics && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" is:inline></script>
    )}
    {enableAnalytics && <script is:inline set:html={analyticsJs} />}
  </head>
  <body class="np">
    <a href="#main" class="sr-only">Skip to content</a>
    <SiteHeader page={page} />
    <main id="main">
      <slot />
    </main>
    <SoundToggle />
  </body>
</html>
